# =======================================================================
#  SRL Chat – environment configuration
#  ONE file for both local development and Docker Compose.
#
#  LOCAL DEVELOPMENT  →  python / flask run
#    Use the "local" values below.
#
#  DOCKER COMPOSE     →  docker compose up
#    Change PG_HOST to "postgresql" and BASE_URL to your LLM endpoint.
# =======================================================================

# ── LLM backend ─────────────────────────────────────────────────────────
# Local Ollama (local dev):
# ── LLM backend ─────────────────────────────────────────────────────────
#BASE_URL=http://localhost:11434/
BASE_URL=https://chat.kiconnect.nrw/api/v1
#BASE_URL=http://catalpa-llm.fernuni-hagen.de:11434/

API_KEY=69e77e2ba62204fd5271ce1f:s3vFLRF3YMAuJ1NQlQlUGRjwD/TpVtlcy/XrfMkPcqc=
#API_KEY=

#MODEL=phi3:latest
MODEL=Mistral-small-4-119b-2603
#MODEL=llama3.1:latest

# Ollama response length (max generated tokens per answer).
# Smaller value = faster answers, but shorter outputs.
OLLAMA_NUM_PREDICT=512 #256

# Ollama context window (how much chat history is considered).
# Smaller value = faster and less RAM usage, but less long-term memory.
OLLAMA_NUM_CTX=4096 #2048

# Get list of models:
# curl https://chat.kiconnect.nrw/api/v1/models -H "Authorization: Bearer 69e77e2ba62204fd5271ce1f:s3vFLRF3YMAuJ1NQlQlUGRjwD/TpVtlcy/XrfMkPcqc="

TEST_STOP_AFTER_CONTEXTS=0

# ── Database ─────────────────────────────────────────────────────────────
# Local dev:
PG_HOST=localhost
# Docker (change to the service name in docker-compose.yml):
# PG_HOST=postgresql
PG_USER=postgres
PG_PORT=5432
PG_PASSWORD=postgres
PG_DB=srl_chat

# ── Application security ─────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# Password for the admin login overlay in the frontend.
# Set to a strong secret in production.
# UI admin password
ADMIN_PASSWORD=admin

# ── Interview / agent behaviour ──────────────────────────────────────────
# JSON file in config/interview/ (without .json extension)
INTERVIEW_PROTOCOL=interview_default

# Set to true to skip LLM calls (useful for UI development)
DISABLE_LLM=false

# ── Embeddings (HuggingFace, used by legacy strategy setup script) ────────
# Only needed when running database/setup.py with embeddings enabled.
# Leave blank to skip embedding generation.
EMBEDDING_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/
EMBEDDING_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG strategy detection ────────────────────────────────────────────────
# Set to true to use pgvector embedding similarity instead of LLM CoT
USE_RAG_STRATEGY=false
# Ollama model for RAG strategy embeddings (must match what was used to seed)
RAG_EMBEDDING_MODEL=nomic-embed-text

# ── Discord bot (optional) ───────────────────────────────────────────────
BOT_TOKEN=
DISCORD_SERVER_ID=
API_URL=http://api:5000

# ── Logging stack (Grafana/Loki via docker-compose) ──────────────────────
GRAFANA_PASSWORD=change-me-in-production

# ── Docker registry (for CI/CD) ──────────────────────────────────────────
REGISTRY=registry.example.com
IMAGE_TAG=latest

# ── Deployment (for CI/CD SSH deploy) ────────────────────────────────────
# Set these as CI/CD variables in GitLab (Settings → CI/CD → Variables):
#   SSH_PRIVATE_KEY   — private key for the deploy user
#   SSH_KNOWN_HOSTS   — output of: ssh-keyscan <DEPLOY_HOST>
DEPLOY_USER=deploy
DEPLOY_HOST=your-server.example.com
DEPLOY_PATH=/opt/srl-chat


