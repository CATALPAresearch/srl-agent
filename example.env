# =======================================================================
#  SRL Agent – environment configuration (copy to .env and fill in)
#  ONE file for both local development and Docker Compose.
#
#  LOCAL DEVELOPMENT  →  poetry run python main.py
#  DOCKER COMPOSE     →  docker compose up -d --build
#    (docker-compose.yml sets PG_HOST/PG_PORT itself)
#
#  REQUIRED in production: SECRET_KEY, PG_PASSWORD, ADMIN_PASSWORD,
#  GRAFANA_PASSWORD, API_KEY + BASE_URL, and for Moodle: LTI_CONSUMER_KEY,
#  LTI_SHARED_SECRET. Generate secrets e.g. with:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
# =======================================================================

# ── LLM backend ─────────────────────────────────────────────────────────
# Remote endpoints must use https:// – API_KEY is never sent over plain http
# to a non-local host. Local Ollama (http://localhost) is fine.
BASE_URL=http://localhost:11434/
# OpenAI-compatible endpoint (e.g. KI:connect):
# BASE_URL=https://chat.kiconnect.nrw/api/v1
API_KEY=
MODEL=phi3:latest

# Ollama response length (max generated tokens per answer).
OLLAMA_NUM_PREDICT=512
# Ollama context window (how much chat history is considered).
OLLAMA_NUM_CTX=4096

# ── Database ─────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=srl_chat
# Alternatively one URL instead of the PG_* values:
# DATABASE_URL=postgresql://user:password@host:5432/srl_chat

# ── Application security ─────────────────────────────────────────────────
# Signs session cookies and identity tokens. REQUIRED, long and random.
# Placeholder values are rejected; without it every worker uses its own random
# key and users lose their session.
SECRET_KEY=

# Admin login (checked server-side only). Empty = admin login disabled.
ADMIN_PASSWORD=

# ── LTI 1.1 (Moodle) ─────────────────────────────────────────────────────
# Consumer key + shared secret exactly as configured in Moodle's external tool.
# Launches are rejected while either value is empty (OAuth signature is verified).
LTI_CONSUMER_KEY=
LTI_SHARED_SECRET=
# Public launch URL Moodle signs, only if it differs from what the reverse proxy
# forwards (e.g. https://srl-agent.example.org/lti/launch). Usually empty.
LTI_LAUNCH_URL=

# ── Interview / agent behaviour ──────────────────────────────────────────
# Active protocol: JSON file in backend/config/interview/ (without .json).
# Protocols are edited in the repository, not in the app.
INTERVIEW_PROTOCOL=interview_default
# true = skip LLM calls (UI development, CI)
DISABLE_LLM=false
# Testing only: finish the interview after N contexts (0 = off)
TEST_STOP_AFTER_CONTEXTS=0

# ── Embeddings (legacy strategy setup script) ────────────────────────────
# Only needed for database/setup.py with embeddings. Must be an https:// URL
# if a token is set.
EMBEDDING_URL=https://api-inference.huggingface.co/pipeline/feature-extraction/
EMBEDDING_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG strategy detection ────────────────────────────────────────────────
# true = pgvector embedding similarity instead of LLM chain-of-thought
USE_RAG_STRATEGY=false
# Ollama model for RAG strategy embeddings (must match what was used to seed)
RAG_EMBEDDING_MODEL=nomic-embed-text

# ── Logging stack (Grafana/Loki) ──────────────────────────────────────────
# REQUIRED: docker compose refuses to start without it. Grafana is only reachable
# on the server (127.0.0.1:3000, use an SSH tunnel). Applied on first start only.
GRAFANA_PASSWORD=

# ── Docker image naming ───────────────────────────────────────────────────
REGISTRY=local
IMAGE_TAG=latest

# ── Discord bot (optional, clients/discord) ──────────────────────────────
BOT_TOKEN=
DISCORD_SERVER_ID=
API_URL=http://api:5000
