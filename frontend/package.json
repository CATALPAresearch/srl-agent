{
  "name": "moodle-mod_openchat",
  "description": "mod_openchat is a ready to use Moodle activity plugin that enables users to chat with an open-source large language model including document chat based on retrieval augmented generation.",
  "version": "1.0.0",
  "author": "Niels Seidel <niels.seidel@fernuni-hagen.de",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --progress",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "tag-latest": "git tag -d latest && git push --delete github latest && git tag latest && git push github latest",
    "sniffer": "phpcbf --standard=moodle ../* && phpcs --standard=moodle ../*",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "axios": "^1.21.1",
    "bootstrap": "^4.6.2",
    "chart.js": "^2.9.4",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "vuex": "^4.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "devDependencies": {
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "style-loader": "^4.0.0",
    "vue-loader": "^17.4.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "engines": {
    "node": ">=22.15"
  }
}
