    "axios": "^1.21.1",
    "bootstrap": "^4.6.2",
    "chart.js": "^2.9.4",
    "jsonpath-plus": "^11.3.0",
    "vue": "^3.5.45",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^4.6.5",
    "vue-showdown": "^4.2.0",
    "vuex": "^4.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
